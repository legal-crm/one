# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: 프로덕션 사이트 URL (도메인)
# Vercel 배포 시 https://mykim.kr 로 설정
VITE_SITE_URL="https://mykim.kr"
# [SEO] 검색엔진 소유권 확인 (빌드 시 index.html에 메타태그 주입, 비밀값 아님)
# 구글 서치 콘솔 > 설정 > 소유권 확인 > HTML 태그의 content 값만 입력
GOOGLE_SITE_VERIFICATION=""
# 빙 웹마스터 > msvalidate.01 content 값 (GSC 가져오기로 인증했다면 비워 둬도 됨)
BING_SITE_VERIFICATION=""
# [SEO] IndexNow 키 (public/<키>.txt 파일 내용과 같아야 함. 비우면 코드 기본값 사용)
INDEXNOW_KEY=""

# ── 마케팅 데일리 오토파일럿 (서버 전용, VITE_ 접두사 금지) ──
# 공통 키는 GEMINI_API_KEY. 역할별 전용 키는 선택 (비용·사용량을 역할별로 나눠 볼 때)
GEMINI_API_KEY_EDITOR=
GEMINI_API_KEY_BLOG=
GEMINI_API_KEY_SHORTS=
GEMINI_API_KEY_SOCIAL=
GEMINI_API_KEY_VISUAL=
# 모델 순서 재정의 (쉼표 구분, 비우면 기본값)
MARKETING_TEXT_MODELS=
MARKETING_IMAGE_MODELS=
MARKETING_TTS_MODELS=
# Vercel Cron 인증 (매일 07:30 KST 초안 생성)
CRON_SECRET=
# 네이버 뉴스 검색 API (선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 자동 게시 (선택) — 스레드 / 페이스북 페이지
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
MARKETING_LANDING_URL=https://mykim.kr
