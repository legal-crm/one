{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/invoice/:action*", "destination": "/api/invoice?action=:action*" },
    { "source": "/api/contract/:action*", "destination": "/api/contract?action=:action*" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/tos", "destination": "/tos.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/check", "destination": "/check.html" },
    { "source": "/lawyers", "destination": "/lawyers.html" },
    { "source": "/reviews", "destination": "/reviews.html" },
    { "source": "/qna", "destination": "/qna.html" },
    { "source": "/news", "destination": "/news.html" },
    { "source": "/guide/:path", "destination": "/guide/:path.html" },
    { "source": "/articles/:path", "destination": "/articles/:path.html" },
    { "source": "/((?!api|assets|guide|articles/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.portone.io https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https: blob:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co https://xgmmvpmoyywpttuslwkh.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net https://accounts.google.com https://*.googleapis.com https://kauth.kakao.com https://kapi.kakao.com https://api.telegram.org https://api.portone.io https://api.odcloud.kr https://challenges.cloudflare.com; frame-src 'self' https://*.portone.io https://*.danalpay.com https://*.inicis.com https://*.kcp.co.kr https://challenges.cloudflare.com; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.mykim.kr" }],
      "destination": "https://mykim.kr/:path",
      "permanent": true
    }
  ]
}
